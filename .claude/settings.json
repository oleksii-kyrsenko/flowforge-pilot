{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__atlassian__transitionJiraIssue|mcp__atlassian__editJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/jira-transition-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-checks.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Write(./.env.*.local)",
      "Read(./.env.development)",
      "Edit(./.env.development)",
      "Write(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env.production)",
      "Write(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env.test)",
      "Write(./.env.test)"
    ]
  }
}
