{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__atlassian__transitionJiraIssue|mcp__atlassian__editJiraIssue|mcp__atlassian__atlassianUserInfo|mcp__atlassian__addCommentToJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/jira-transition-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-checks.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__figma__get_metadata",
      "mcp__figma__get_design_context",
      "mcp__figma__get_variable_defs",
      "mcp__figma__get_screenshot",
      "mcp__figma__download_assets",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:run:*)",
      "Bash(npm run format:check:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Write(./.env.*.local)",
      "Read(./.env.development)",
      "Edit(./.env.development)",
      "Write(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env.production)",
      "Write(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env.test)",
      "Write(./.env.test)"
    ]
  }
}
